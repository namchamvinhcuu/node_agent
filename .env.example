# Dia chi cua EDGE (khong phai Odoo Main) - vd http://10.10.1.50:8000
NODE_EDGE_URL=http://10.10.1.50:8000

# Serial cua CHINH thiet bi nay - PI-LINE1, MAC cua ESP32, hoac ten tuy chon.
# Phai KHOP voi pcm.device.serial ben Odoo (hoac de Odoo tu tao ban ghi moi
# tu serial nay khi edge chuyen tiep du lieu lan dau).
NODE_SERIAL=PI-LINE1

NODE_NAME=Node LINE1 (can dien tu)
# pi | esp32 | pc | other
NODE_KIND=pi

# File mo ta cac kenh cua node nay - xem channels.example.json
NODE_CHANNELS_FILE=./channels.json

NODE_STATE_DIR=./var

NODE_HELLO_INTERVAL_S=60
NODE_HEARTBEAT_INTERVAL_S=30
NODE_SUBMIT_INTERVAL_S=2
NODE_COMMAND_POLL_INTERVAL_S=2
